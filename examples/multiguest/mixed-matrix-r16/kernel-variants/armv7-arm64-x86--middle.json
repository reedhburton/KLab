{
  "schema": "klab-multiguest-scenario-v2",
  "timeout_seconds": 120,
  "matrix": {
    "tier": "stable",
    "client_arch": "armv7",
    "router_arch": "aarch64",
    "server_arch": "x86_64",
    "kernel_cohort": "middle",
    "kernel_versions": {
      "client": "v5.4",
      "router": "v5.4",
      "server": "v5.4"
    }
  },
  "networks": [
    {
      "id": "lan-client",
      "cidr": "10.78.10.0/24",
      "capture": true
    },
    {
      "id": "lan-server",
      "cidr": "10.78.20.0/24",
      "capture": true
    }
  ],
  "guests": [
    {
      "id": "client",
      "target": "upstream:v5.4",
      "arch": "armv7",
      "interfaces": [
        {
          "id": "net0",
          "network": "lan-client",
          "ip": "10.78.10.11/24"
        }
      ],
      "routes": [
        {
          "to": "10.78.20.0/24",
          "via": "10.78.10.1"
        }
      ],
      "builds": [
        {
          "id": "netpair",
          "source": "../../network-pair.c",
          "remote": "/tmp/netpair",
          "static": true
        }
      ],
      "processes": [
        {
          "id": "client",
          "command": "/tmp/netpair client 10.78.20.11 24003 matrix-armv7-arm64-x86",
          "expected_exit": 0,
          "depends_on": [
            {
              "guest": "server",
              "process": "server",
              "state": "ready"
            }
          ]
        }
      ]
    },
    {
      "id": "router",
      "target": "upstream:v5.4",
      "arch": "aarch64",
      "forward_ipv4": true,
      "interfaces": [
        {
          "id": "left",
          "network": "lan-client",
          "ip": "10.78.10.1/24"
        },
        {
          "id": "right",
          "network": "lan-server",
          "ip": "10.78.20.1/24"
        }
      ]
    },
    {
      "id": "server",
      "target": "upstream:v5.4",
      "arch": "x86_64",
      "interfaces": [
        {
          "id": "net0",
          "network": "lan-server",
          "ip": "10.78.20.11/24"
        }
      ],
      "routes": [
        {
          "to": "10.78.10.0/24",
          "via": "10.78.20.1"
        }
      ],
      "builds": [
        {
          "id": "netpair",
          "source": "../../network-pair.c",
          "remote": "/tmp/netpair",
          "static": true
        }
      ],
      "processes": [
        {
          "id": "server",
          "command": "/tmp/netpair server 24003 1",
          "ready": {
            "stdout": "SERVER_READY"
          },
          "expected_exit": 0
        }
      ]
    }
  ]
}
