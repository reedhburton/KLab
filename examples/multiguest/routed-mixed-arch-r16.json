{
  "schema": "klab-multiguest-scenario-v2",
  "timeout_seconds": 90,
  "networks": [
    {
      "id": "lan-client",
      "cidr": "10.77.80.0/24",
      "capture": true
    },
    {
      "id": "lan-server",
      "cidr": "10.77.90.0/24",
      "capture": true,
      "delay_us": 2500
    }
  ],
  "guests": [
    {
      "id": "client-x86",
      "target": "upstream:v5.15",
      "arch": "x86_64",
      "interfaces": [
        {
          "id": "net0",
          "network": "lan-client",
          "ip": "10.77.80.11/24"
        }
      ],
      "routes": [
        {
          "to": "10.77.90.0/24",
          "via": "10.77.80.1"
        }
      ],
      "builds": [
        {
          "id": "netpair",
          "source": "../network-pair.c",
          "remote": "/tmp/netpair",
          "static": true
        }
      ],
      "processes": [
        {
          "id": "client",
          "command": "/tmp/netpair client 10.77.90.11 24003 mixed-arch-routed",
          "expected_exit": 0,
          "depends_on": [
            {
              "guest": "server-i386",
              "process": "server",
              "state": "ready"
            }
          ]
        }
      ]
    },
    {
      "id": "router-arm64",
      "target": "upstream:v6.6",
      "arch": "aarch64",
      "forward_ipv4": true,
      "interfaces": [
        {
          "id": "left",
          "network": "lan-client",
          "ip": "10.77.80.1/24"
        },
        {
          "id": "right",
          "network": "lan-server",
          "ip": "10.77.90.1/24"
        }
      ]
    },
    {
      "id": "server-i386",
      "target": "upstream:v5.10",
      "arch": "i386",
      "interfaces": [
        {
          "id": "net0",
          "network": "lan-server",
          "ip": "10.77.90.11/24"
        }
      ],
      "routes": [
        {
          "to": "10.77.80.0/24",
          "via": "10.77.90.1"
        }
      ],
      "builds": [
        {
          "id": "netpair",
          "source": "../network-pair.c",
          "remote": "/tmp/netpair",
          "static": true
        }
      ],
      "processes": [
        {
          "id": "server",
          "command": "/tmp/netpair server 24003 1",
          "ready": {
            "stdout": "SERVER_READY"
          },
          "expected_exit": 0
        }
      ]
    }
  ]
}
