      "processes": [{"id":"client","command":"/tmp/netpair client 10.77.2.11 23458 from-arm64","gate":{"name":"start"},"expected_exit":0}]
    },
    {
      "id": "client-i386", "target": "upstream:v6.6", "arch": "i386",
      "builds": [{"id":"netpair","source":"../network-pair.c","remote":"/tmp/netpair","static":true}],
      "processes": [{"id":"client","command":"/tmp/netpair client 10.77.2.11 23458 from-i386","gate":{"name":"start"},"expected_exit":0}]
    }
  ]
