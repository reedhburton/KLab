    {
      "id": "client", "target": "upstream:v6.6", "arch": "x86_64",
      "builds": [{"id":"netpair","source":"../network-pair.c","remote":"/tmp/netpair","static":true}],
      "processes": [{"id":"client","command":"/tmp/netpair client 10.77.0.11 23456 hello-from-client","gate":{"name":"start"},"expected_exit":0}]
    }
  ]
